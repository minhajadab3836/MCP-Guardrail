{
  "name": "mcp-guardrail",
  "version": "1.0.0",
  "description": "Production-grade security and rate-limiting proxy for MCP servers",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'tsx' src/index.ts",
    "test": "tsx scripts/test-suite.ts",
    "traffic": "tsx scripts/generate-traffic.ts",
    "bridge": "tsx src/cli/bridge.ts"
  },
  "keywords": [
    "mcp",
    "security",
    "proxy",
    "rate-limiting",
    "prompt-injection"
  ],
  "author": "Md Minhaj Adab",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "ioredis": "^6.0.0",
    "js-yaml": "^5.5.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
